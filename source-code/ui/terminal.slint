import { VerticalBox, HorizontalBox } from "std-widgets.slint";

global Theme {
    out property <color> bg:               #0a0a12;
    out property <color> glass:            #1a1a2ea0;
    out property <color> glassBorder:      #2a2a44b0;
    out property <color> glassHover:       #2a2a44e0;
    out property <color> fg:               #e2e8ff;
    out property <color> fgDim:            #99aaff;
    out property <color> accent:           #00ffcc;
    out property <color> accent2:          #aa66ff;
    out property <color> close:            #ff5f5f;
}

export component HackerTermWindow inherits Window {
    title: "Hacker Term";
    background: Theme.bg;
    min-width: 680px;
    min-height: 480px;
    preferred-width: 1200px;
    preferred-height: 720px;

    in property <image> canvas-image;
    in property <[string]> tab-titles;
    in property <int> active-tab: 0;
    out property <length> win-width:  root.width;
    out property <length> win-height: root.height;

    callback key-input(string, bool, bool, bool);
    callback new-tab();
    callback close-tab(int);
    callback switch-tab(int);
    callback scroll-up();
    callback scroll-down();

    // Tło glassmorphism
    Rectangle {
        width: 100%; height: 100%;
        background: @linear-gradient(135deg, #0a0a12 0%, #1a1a2e 100%);

        Rectangle {
            width: 100%; height: 100%;
            background: rgba(30, 30, 60, 0.15);
        }

        Rectangle {
            x: -80px; y: -80px; width: 300px; height: 300px;
            border-radius: 150px;
            background: @radial-gradient(circle, rgba(0, 255, 204, 0.1) 0%, transparent 70%);
        }
        Rectangle {
            x: root.width - 300px; y: root.height - 300px;
            width: 360px; height: 360px;
            border-radius: 180px;
            background: @radial-gradient(circle, rgba(170, 102, 255, 0.1) 0%, transparent 70%);
        }
    }

    VerticalLayout {
        padding: 8px; spacing: 6px;

        // Górny pasek tytułowy
        Rectangle {
            height: 42px;
            background: Theme.glass;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.glassBorder;
            clip: true;

            HorizontalLayout {
                padding-left: 16px; padding-right: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px; alignment: center;
                    Text {
                        text: "⚡";
                        font-size: 20px;
                        color: Theme.accent;
                    }
                    Text {
                        text: "HACKER TERM";
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.fg;
                        letter-spacing: 2px;
                    }
                }

                HorizontalLayout {
                    spacing: 10px; alignment: center;
                    Rectangle { width: 14px; height: 14px; border-radius: 7px; background: #ff5f57; }
                    Rectangle { width: 14px; height: 14px; border-radius: 7px; background: #febc2e; }
                    Rectangle { width: 14px; height: 14px; border-radius: 7px; background: #28c840; }
                }
            }
        }

        // Pasek zakładek
        Rectangle {
            height: 40px;
            background: Theme.glass;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.glassBorder;

            HorizontalLayout {
                padding-left: 8px; padding-right: 8px;
                spacing: 4px;
                alignment: start;

                for title[i] in root.tab-titles : Rectangle {
                    height: 32px;
                    background: i == root.active-tab ? Theme.glassHover : transparent;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: i == root.active-tab ? Theme.accent : Theme.glassBorder;

                    states [
                        hovered : {
                            background: Theme.glassHover;
                        }
                    ]

                    HorizontalLayout {
                        spacing: 8px;
                        padding-left: 12px;
                        padding-right: 8px;
                        alignment: center;

                        Text {
                            text: title;
                            font-size: 12px;
                            color: i == root.active-tab ? Theme.accent : Theme.fgDim;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            width: 20px;
                            height: 20px;
                            clicked => { root.close-tab(i); }
                            Rectangle {
                                width: 100%; height: 100%;
                                border-radius: 10px;
                                background: transparent;
                                Text {
                                    text: "✕";
                                    font-size: 10px;
                                    color: Theme.close;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    touch := TouchArea {
                        clicked => { root.switch-tab(i); }
                    }
                }

                TouchArea {
                    width: 32px; height: 32px;
                    clicked => { root.new-tab(); }
                    Rectangle {
                        width: 100%; height: 100%;
                        border-radius: 10px;
                        background: Theme.glass;
                        border-width: 1px;
                        border-color: Theme.glassBorder;

                        states [
                            hovered : {
                                background: Theme.glassHover;
                            }
                        ]

                        Text {
                            text: "+";
                            font-size: 20px;
                            color: Theme.accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Obszar terminala
        canvas-wrap := Rectangle {
            background: transparent;
            clip: true;

            if root.tab-titles.length > 0 && root.active-tab >= 0 && root.active-tab < root.tab-titles.length : Rectangle {
                y: 0px; width: parent.width; height: 28px;
                background: rgba(0,0,0,0.7);
                border-radius: 12px;
                z: 10;
                Text {
                    text: "▲ scrollback – przewiń w dół, by wrócić ▲";
                    font-size: 10px; color: Theme.accent;
                    width: parent.width; horizontal-alignment: center; y: 6px;
                }
            }

            Image {
                width: parent.width; height: parent.height;
                source: root.canvas-image;
                image-rendering: pixelated;
            }

            fs := FocusScope {
                width: parent.width; height: parent.height;

                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => { fs.focus(); }
                    scroll-event(ev) => {
                        if (ev.delta-y > 0) { root.scroll-up(); }
                        else { root.scroll-down(); }
                        accept
                    }
                }

                key-pressed(event) => {
                    root.key-input(
                        event.text,
                        event.modifiers.control,
                        event.modifiers.alt,
                        event.modifiers.shift
                    );
                    accept
                }
            }
        }

        // Dolny pasek statusu
        Rectangle {
            height: 28px;
            background: Theme.glass;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.glassBorder;

            HorizontalLayout {
                padding-left: 16px; padding-right: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px; alignment: center;
                    Text { text: "⚡ zsh"; font-size: 10px; color: Theme.accent; }
                    Text { text: "utf-8"; font-size: 10px; color: Theme.fgDim; }
                }
                HorizontalLayout {
                    spacing: 12px; alignment: center;
                    Text { text: "Ctrl+T ⇢ nowa karta  |  Ctrl+W ⇢ zamknij"; font-size: 9px; color: Theme.fgDim; }
                    Rectangle {
                        width: 8px; height: 8px; border-radius: 4px;
                        background: Theme.accent;
                        opacity: 0.8;
                    }
                }
            }
        }
    }

    // Ozdobne krawędzie
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 1px;
        background: @linear-gradient(90deg, transparent 0%, Theme.accent 40%, Theme.accent2 60%, transparent 100%);
        opacity: 0.5;
    }
}
