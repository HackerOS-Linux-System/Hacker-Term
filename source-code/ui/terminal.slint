import { VerticalBox } from "std-widgets.slint";

global T {
    // Półprzezroczyste ciemne tło jak w Contour
    out property <color> bg:         #0d0d1a;
    out property <color> bar:        #00000045;
    out property <color> border:     #ffffff12;
    out property <color> borderAct:  #6677ff55;
    out property <color> fg:         #d0d8f0;
    out property <color> fgMid:      #6070a0;
    out property <color> fgDim:      #38456a;
    out property <color> accent:     #7788ff;
    out property <color> accentGlow: #7788ff22;
    out property <color> red:        #ff5555;
    out property <color> tabAct:     #7788ff18;
}

component TabX inherits Rectangle {
    callback clicked();
    width: 16px; height: 16px;
    border-radius: 8px;
    background: transparent;
    x_ta := TouchArea { clicked => { root.clicked(); } }
    states [ hov when x_ta.has-hover: { background: T.red.with-alpha(0.22); } ]
    animate background { duration: 80ms; }
    Text {
        text: "×"; font-size: 12px;
        color: x_ta.has-hover ? T.red : T.fgDim;
        horizontal-alignment: center; vertical-alignment: center;
        animate color { duration: 80ms; }
    }
}

component SBtn inherits Rectangle {
    in property <string> ico: "⚙";
    callback clicked();
    width: 28px; height: 28px;
    border-radius: 7px; border-width: 1px;
    border-color: T.border; background: transparent;
    s_ta := TouchArea { clicked => { root.clicked(); } }
    states [ hov when s_ta.has-hover: { background: #ffffff12; border-color: T.borderAct; } ]
    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }
    Text {
        text: root.ico; font-size: 13px;
        color: s_ta.has-hover ? T.accent : T.fgMid;
        horizontal-alignment: center; vertical-alignment: center;
        animate color { duration: 100ms; }
    }
}

export component HackerTermWindow inherits Window {
    title: "Hacker Term";
    background: T.bg;
    min-width: 640px; min-height: 420px;
    preferred-width: 1280px; preferred-height: 800px;

    in  property <image>    canvas_image;
    in  property <[string]> tab_titles;
    in  property <int>      active_tab: 0;
    out property <length>   win_width:  root.width;
    out property <length>   win_height: root.height;

    callback key_input(string, bool, bool, bool);
    callback new_tab();
    callback close_tab(int);
    callback switch_tab(int);
    callback scroll_up();
    callback scroll_down();
    callback move_tab(int, int);
    callback mouse_pressed(float, float, int);
    callback mouse_moved(float, float);
    callback mouse_released(float, float);

    property <bool> prev_pressed:   false;
    property <bool> settings_open:  false;

    // ── Tło okna: ciemny fiolet jak Contour ──────────────────────────────────
    Rectangle {
        width: 100%; height: 100%;
        background: @linear-gradient(160deg, #0d0d20 0%, #080814 60%, #0a0818 100%);
    }
    // Subtelny blask z góry-lewej
    Rectangle {
        x: -60px; y: -60px; width: 500px; height: 400px;
        border-radius: 250px;
        background: @radial-gradient(circle, #3344aa18 0%, transparent 70%);
    }
    // Subtelny blask z dołu-prawej
    Rectangle {
        x: root.width - 400px; y: root.height - 300px;
        width: 500px; height: 400px;
        border-radius: 250px;
        background: @radial-gradient(circle, #220a3318 0%, transparent 70%);
    }

    VerticalLayout {
        padding: 0px; spacing: 0px;

        // ── Topbar ────────────────────────────────────────────────────────────
        Rectangle {
            height: 40px;
            background: T.bar;

            // Dolna linia
            Rectangle {
                y: 39px; width: parent.width; height: 1px;
                background: T.border;
            }
            // Centralny accent
            Rectangle {
                x: parent.width / 2 - 100px; y: 0px;
                width: 200px; height: 1px;
                background: @linear-gradient(90deg, transparent 0%, T.accent.with-alpha(0.35) 50%, transparent 100%);
            }

            HorizontalLayout {
                padding-left: 12px; padding-right: 10px; spacing: 0px;

                // Logo
                HorizontalLayout {
                    width: 122px; spacing: 7px; alignment: center;
                    Text { text: "⚡"; font-size: 13px; color: T.accent; vertical-alignment: center; }
                    Text {
                        text: "Hacker Term"; font-size: 11px; font-weight: 600;
                        color: T.fg; vertical-alignment: center;
                    }
                }

                // Separator
                Rectangle { width: 1px; height: 18px; background: T.border; y: 11px; }

                // Zakładki
                HorizontalLayout {
                    horizontal-stretch: 1; spacing: 2px;
                    alignment: start;
                    padding-left: 6px;
                    padding-top: 5px; padding-bottom: 5px;

                    for title[i] in root.tab_titles : Rectangle {
                        property <bool> act: i == root.active_tab;
                        min-width: 80px; max-width: 200px;
                        height: 30px; border-radius: 6px;
                        border-width: 1px;
                        border-color: act ? T.borderAct : transparent;
                        background: act ? T.tabAct : transparent;
                        animate background   { duration: 140ms; }
                        animate border-color { duration: 140ms; }

                        t_ta := TouchArea { clicked => { root.switch_tab(i); } }
                        states [ hov when t_ta.has-hover && !act: { background: #ffffff0d; } ]

                        HorizontalLayout {
                            padding-left: 9px; padding-right: 4px; spacing: 5px; alignment: center;
                            Text {
                                text: title; font-size: 11px;
                                color: act ? T.fg : T.fgMid;
                                vertical-alignment: center;
                                horizontal-stretch: 1; overflow: elide;
                                animate color { duration: 140ms; }
                            }
                            TabX { clicked => { root.close_tab(i); } }
                        }
                    }

                    // + nowa karta
                    Rectangle {
                        width: 28px; height: 28px; border-radius: 6px;
                        background: transparent; border-width: 1px; border-color: transparent;
                        nt := TouchArea { clicked => { root.new_tab(); } }
                        states [ hov when nt.has-hover: { background: #ffffff0d; border-color: T.border; } ]
                        animate background { duration: 100ms; }
                        Text {
                            text: "+"; font-size: 16px;
                            color: nt.has-hover ? T.accent : T.fgDim;
                            horizontal-alignment: center; vertical-alignment: center;
                            animate color { duration: 100ms; }
                        }
                    }
                }

                // Przycisk ustawień
                SBtn {
                    ico: "⚙";
                    clicked => { root.settings_open = !root.settings_open; }
                }
            }
        }

        // ── Canvas terminala ──────────────────────────────────────────────────
        Rectangle {
            horizontal-stretch: 1; vertical-stretch: 1;
            background: transparent; clip: true;

            Image {
                width: parent.width; height: parent.height;
                source: root.canvas_image;
                image-rendering: pixelated;
            }

            fs := FocusScope {
                width: parent.width; height: parent.height;
                ct := TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => { fs.focus(); }
                    moved => {
                        let mx = ct.mouse-x / 1px;
                        let my = ct.mouse-y / 1px;
                        if ct.pressed {
                            if !root.prev_pressed {
                                root.mouse_pressed(mx, my, 1);
                                root.prev_pressed = true;
                            }
                            root.mouse_moved(mx, my);
                        } else {
                            if root.prev_pressed {
                                root.mouse_released(mx, my);
                                root.prev_pressed = false;
                            } else {
                                root.mouse_moved(mx, my);
                            }
                        }
                    }
                    scroll-event(ev) => {
                        if ev.delta-y > 0 { root.scroll_up(); } else { root.scroll_down(); }
                        accept
                    }
                }
                key-pressed(e) => {
                    root.key_input(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift);
                    accept
                }
            }
        }

        // ── Status bar ────────────────────────────────────────────────────────
        Rectangle {
            height: 22px; background: T.bar;
            Rectangle { y: 0px; width: parent.width; height: 1px; background: T.border; }
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px; alignment: space-between;
                HorizontalLayout {
                    spacing: 8px; alignment: center;
                    Rectangle { width: 5px; height: 5px; border-radius: 3px; background: T.accent; opacity: 0.7; }
                    Text { text: "hsh";      font-size: 10px; color: T.accent; }
                    Rectangle { width: 1px; height: 9px; background: T.border; }
                    Text { text: "UTF-8";    font-size: 10px; color: T.fgDim; }
                    Rectangle { width: 1px; height: 9px; background: T.border; }
                    Text { text: "truecolor"; font-size: 10px; color: T.fgDim; }
                }
                Text { text: "HackerOS · Hacker Term"; font-size: 10px; color: T.fgDim; vertical-alignment: center; }
            }
        }
    }

    // ── Panel ustawień (dropdown z prawej) ────────────────────────────────────
    if root.settings_open : Rectangle {
        x: root.width - 310px; y: 48px;
        width: 296px; height: 480px;
        border-radius: 12px; border-width: 1px;
        border-color: T.border;
        background: #0c0c1ef2;
        clip: true;

        // Nagłówek panelu
        Rectangle {
            y: 0px; width: parent.width; height: 44px;
            background: #ffffff08;
            Rectangle { y: 43px; width: parent.width; height: 1px; background: T.border; }
            HorizontalLayout {
                padding-left: 14px; padding-right: 8px; alignment: space-between;
                Text { text: "Ustawienia"; font-size: 12px; font-weight: 600; color: T.fg; vertical-alignment: center; }
                SBtn { ico: "×"; clicked => { root.settings_open = false; } }
            }
        }

        VerticalLayout {
            y: 52px; padding-left: 14px; padding-right: 14px; spacing: 0px;

            // Sekcja WYGLĄD
            Text { text: "WYGLĄD"; font-size: 9px; letter-spacing: 2px; color: T.accent; height: 26px; vertical-alignment: center; }

            for row in [
                "motion_blur_strength  (0.0–1.0)",
                "effects.scanlines     (true/false)",
                "effects.cursor_style  (block/beam/underline)",
                "effects.border_glow   (true/false)",
                "effects.vignette      (true/false)",
                "effects.bg_animation_speed",
            ] : Rectangle {
                height: 30px;
                Rectangle { y: 29px; width: parent.width; height: 1px; background: T.border; }
                Text { text: row; font-size: 10px; color: T.fgMid; vertical-alignment: center; height: 30px; }
            }

            Rectangle { height: 8px; }
            Text { text: "SYSTEM"; font-size: 9px; letter-spacing: 2px; color: T.accent; height: 26px; vertical-alignment: center; }

            for row2 in [
                "general.shell         (/bin/zsh)",
                "font.path             (ścieżka do .ttf)",
                "general.padding       (piksele)",
                "general.scrollback_lines",
            ] : Rectangle {
                height: 30px;
                Rectangle { y: 29px; width: parent.width; height: 1px; background: T.border; }
                Text { text: row2; font-size: 10px; color: T.fgMid; vertical-alignment: center; height: 30px; }
            }

            Rectangle { height: 12px; }

            // Info box
            Rectangle {
                height: 48px; border-radius: 8px;
                border-width: 1px; border-color: T.border; background: #ffffff06;
                VerticalLayout {
                    padding: 8px; spacing: 2px;
                    Text { text: "Edytuj plik konfiguracyjny:"; font-size: 9px; color: T.fgDim; }
                    Text { text: "~/.config/hacker-term/config.hk"; font-size: 10px; color: T.accent; }
                }
            }
        }
    }

    // Górna kreska akcentu
    Rectangle {
        x: 0px; y: 0px; width: root.width; height: 1px;
        background: @linear-gradient(90deg, transparent 0%, T.accent.with-alpha(0.3) 40%, #aa88ff.with-alpha(0.2) 60%, transparent 100%);
    }
}
