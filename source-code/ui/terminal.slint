import { VerticalBox, HorizontalBox } from "std-widgets.slint";

global Theme {
    out property <color> bg:       #0c0c14;
    out property <color> surface:  #12121e;
    out property <color> surface2: #1a1a2e;
    out property <color> border:   #1e2440;
    out property <color> fg:       #e2e8ff;
    out property <color> fg-dim:   #6677aa;
    out property <color> accent:   #00ffd9;
    out property <color> accent2:  #d94fff;
    out property <color> accent3:  #3399ff;
    out property <color> green:    #00ff88;
    out property <color> yellow:   #ffd700;
}

export component NeonTermWindow inherits Window {
    title: "NeonTerm";
    background: Theme.bg;
    min-width: 600px;
    min-height: 400px;
    preferred-width: 1100px;
    preferred-height: 680px;

    in property <image>  canvas-image;
    in property <string> shell-title: "zsh";
    in property <bool>   is-scrolled: false;
    in property <int>    scroll-lines: 0;

    out property <length> win-width:  root.width;
    out property <length> win-height: root.height;

    // Key event: text + individual modifier booleans
    // (Slint does not support bitwise | operator in expressions)
    callback key-input(string /*text*/, bool /*ctrl*/, bool /*alt*/, bool /*shift*/);
    callback scroll-up();
    callback scroll-down();

    // Background + corner glows
    Rectangle {
        width: 100%; height: 100%;
        background: Theme.bg;
        Rectangle {
            x: -80px; y: -80px; width: 400px; height: 400px;
            border-radius: 200px;
            background: @radial-gradient(circle, #00ffd91a 0%, transparent 70%);
        }
        Rectangle {
            x: root.width - 320px; y: root.height - 300px;
            width: 360px; height: 300px; border-radius: 180px;
            background: @radial-gradient(circle, #d94fff14 0%, transparent 70%);
        }
    }

    VerticalLayout {
        padding: 0px; spacing: 0px;

        // ── Title bar ─────────────────────────────────────────────────────────
        Rectangle {
            height: 38px;
            background: @linear-gradient(180deg, #1c1c32f5 0%, #0e0e1ef5 100%);
            Rectangle {
                y: parent.height - 2px; width: parent.width; height: 2px;
                background: @linear-gradient(90deg,
                    transparent 0%, Theme.accent 25%, Theme.accent2 50%,
                    Theme.accent3 75%, transparent 100%);
                opacity: 0.9;
            }
            HorizontalLayout {
                padding-left: 14px; padding-right: 14px;
                alignment: space-between;
                HorizontalLayout {
                    spacing: 8px; alignment: center;
                    Rectangle {
                        width: 24px; height: 24px; border-radius: 5px;
                        background: @linear-gradient(135deg, Theme.accent 0%, Theme.accent3 100%);
                        Text {
                            text: "⚡"; font-size: 14px; color: #0c0c14;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "NeonTerm"; font-size: 13px; font-weight: 700;
                        color: Theme.accent; letter-spacing: 1.5px; vertical-alignment: center;
                    }
                    Rectangle { width: 1px; height: 16px; background: Theme.border; }
                    Text {
                        text: root.shell-title; font-size: 11px;
                        color: Theme.fg-dim; vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 7px; alignment: center;
                    for col in [#ff5f57, #febc2e, #28c840] : Rectangle {
                        width: 13px; height: 13px; border-radius: 6.5px;
                        background: col; opacity: 0.88;
                    }
                }
            }
        }

        // ── Tab bar ───────────────────────────────────────────────────────────
        Rectangle {
            height: 28px; background: #0a0a12f8;
            Rectangle {
                x: 12px; y: 3px; height: 22px; border-radius: 5px;
                background: @linear-gradient(180deg, #20203a 0%, #16162a 100%);
                border-width: 1px; border-color: Theme.border;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px;
                    spacing: 6px; alignment: center;
                    Rectangle {
                        width: 7px; height: 7px; border-radius: 3.5px;
                        background: Theme.accent;
                    }
                    Text {
                        text: "terminal"; font-size: 10.5px;
                        color: Theme.fg; vertical-alignment: center;
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px; width: parent.width; height: 1px;
                background: Theme.border;
            }
        }

        // ── Canvas area ───────────────────────────────────────────────────────
        canvas-wrap := Rectangle {
            background: transparent; clip: true;

            if root.is-scrolled : Rectangle {
                y: 0px; width: parent.width; height: 24px;
                background: @linear-gradient(180deg, #0c0c14e8 0%, transparent 100%);
                z: 10;
                Text {
                    text: "▲  scrollback — scroll down to return  ▲";
                    font-size: 10px; color: Theme.yellow;
                    width: parent.width; horizontal-alignment: center; y: 5px;
                }
            }

            Image {
                width: parent.width; height: parent.height;
                source: root.canvas-image;
                image-rendering: pixelated;
            }

            // Left accent stripe
            Rectangle {
                x: 0px; width: 2px; height: parent.height;
                background: @linear-gradient(180deg,
                    transparent 0%, Theme.accent3 30%, Theme.accent 55%,
                    Theme.accent2 75%, transparent 100%);
                opacity: 0.35;
            }

            // FocusScope — keyboard + scroll
            fs := FocusScope {
                width: parent.width; height: parent.height;

                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => { fs.focus(); }
                    scroll-event(ev) => {
                        if (ev.delta-y > 0) { root.scroll-up(); }
                        else { root.scroll-down(); }
                        accept
                    }
                }

                // Pass text + each modifier as a separate bool
                // Rust side uses slint::platform::Key::try_from(char) to detect specials
                key-pressed(event) => {
                    root.key-input(
                        event.text,
                        event.modifiers.control,
                        event.modifiers.alt,
                        event.modifiers.shift
                    );
                    accept
                }
            }
        }

        // ── Status bar ────────────────────────────────────────────────────────
        Rectangle {
            height: 22px; background: #080810f8;
            Rectangle {
                y: 0px; width: parent.width; height: 1px;
                background: Theme.border;
            }
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px;
                alignment: space-between;
                HorizontalLayout {
                    spacing: 10px; alignment: center;
                    Rectangle {
                        height: 14px; border-radius: 3px;
                        background: @linear-gradient(90deg, Theme.accent3 0%, Theme.accent 100%);
                        HorizontalLayout {
                            padding-left: 6px; padding-right: 6px; alignment: center;
                            Text {
                                text: "  NEON  "; font-size: 8px; font-weight: 700;
                                color: #0c0c14; letter-spacing: 1.5px; vertical-alignment: center;
                            }
                        }
                    }
                    Text { text: "zsh";   font-size: 10px; color: Theme.accent;  vertical-alignment: center; }
                    Text { text: "utf-8"; font-size: 10px; color: Theme.fg-dim; vertical-alignment: center; }
                }
                HorizontalLayout {
                    spacing: 12px; alignment: center;
                    Text {
                        text: "wheel: scroll"; font-size: 9px;
                        color: Theme.fg-dim; opacity: 0.55; vertical-alignment: center;
                    }
                    Rectangle {
                        height: 14px; border-radius: 3px;
                        background: Theme.surface2;
                        border-width: 1px; border-color: Theme.border;
                        HorizontalLayout {
                            padding-left: 6px; padding-right: 6px;
                            Text {
                                text: "GPU ✓"; font-size: 8.5px;
                                color: Theme.green; vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    // Window edge glows
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 1px;
        background: @linear-gradient(90deg,
            transparent 0%, Theme.accent 35%, Theme.accent2 65%, transparent 100%);
        opacity: 0.7;
    }
    Rectangle {
        x: 0px; y: parent.height - 1px; width: parent.width; height: 1px;
        background: @linear-gradient(90deg,
            transparent 0%, Theme.accent3 50%, transparent 100%);
        opacity: 0.45;
    }
}
