{
  "name": "Hacker-Term",
  "version": "0.1.0",
  "description": "Terminal for HackerOS",
  "main": "main.js",
  "author": "HackerOS Team",
  "license": "MIT",

  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux AppImage"
  },

  "build": {
    "appId": "com.hackeros.hackerterm",
    "productName": "Hacker-Term",
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "files": [
      "**/*",
      "!node_modules/*/{test,__tests__}/**/*"
    ]
  },

  "dependencies": {
    "electron": "^25.0.0",
    "node-pty": "^1.0.0",
    "xterm": "^5.1.0",
    "xterm-addon-fit": "^0.7.0",
    "xterm-addon-web-links": "^0.8.0"
  },

  "devDependencies": {
    "electron-builder": "^24.13.3"
  }
}
