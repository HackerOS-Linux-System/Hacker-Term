[package]
-> name        => hacker-term
-> version     => 1.0.0
-> description => HackerTerm — emulator terminala dla HackerOS (H# + Silver + TypeScript + Solid.js)
-> authors     => ["HackerOS Team <hackeros068@gmail.com>"]
-> license     => MPL-2.0
-> lang        => h#

[layout]
-> src => src

[edition]
-> edition   => 2026
-> toolchain => 0.9

[build]
-> link            => static
-> native          => sh native/build.sh
-> native-lib-path => native/build
-> native-skip-if  => native/build/libhtpty.a

[dependencies]
-> silver => newest

[default-build]
-> profile => release
-> target  => h#
-> emit    => bin
-> run     => true

[hooks]
-> pre-build => cd frontend && npm install --no-audit --no-fund && npm run build

[commands]
-> frontend
--> run => cd frontend && npm install --no-audit --no-fund && npm run build
--> description => Zbuduj frontend (TypeScript + Solid → frontend/dist/app.js)
-> watch
--> run => cd frontend && npm run watch
--> description => Buduj frontend przy każdej zmianie (uruchom razem z `bit run`)
-> test
--> run => cd frontend && npm test && cd .. && h# test src/config_test.h#
--> description => Testy emulatora VT/parsera .hk (TS) oraz parsera .hk (H#)
-> typecheck
--> run => cd frontend && npm run typecheck
--> description => tsc --noEmit
